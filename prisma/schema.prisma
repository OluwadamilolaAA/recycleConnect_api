generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HOUSEHOLD
  COLLECTOR
  RECYCLER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(100)
  email           String        @unique @db.VarChar(254)
  passwordHash    String
  role            Role          @default(HOUSEHOLD)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  addresses Address[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetChallenges PasswordResetChallenge[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  userAgent String?   @db.VarChar(500)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  tokenHash String @unique @db.VarChar(64)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  otpHash        String    @db.VarChar(64)
  attempts       Int       @default(0)
  expiresAt      DateTime
  verifiedAt     DateTime?
  resetTokenHash String?   @unique @db.VarChar(64)
  resetExpiresAt DateTime?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model EmailOutbox {
  id               String    @id @default(uuid()) @db.Uuid
  encryptedPayload String?
  expiresAt        DateTime
  sentAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([sentAt, expiresAt])
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  label     String   @db.VarChar(50)
  street    String   @db.VarChar(255)
  city      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  country   String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  landmark String? @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
