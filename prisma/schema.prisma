generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  HOUSEHOLD
  COLLECTOR
  RECYCLER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum PickupStatus {
  PENDING
  CLAIMED
  AWAITING_CONFIRMATION
  COMPLETED
  CANCELLED
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  name            String        @db.VarChar(100)
  email           String        @unique @db.VarChar(254)
  passwordHash    String
  role            Role          @default(HOUSEHOLD)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  householdPickups PickupRequest[] @relation("HouseholdPickups")
  collectorPickups PickupRequest[] @relation("CollectorPickups")
  acceptedMaterials RecyclerMaterial[]
  addresses Address[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetChallenges PasswordResetChallenge[]
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  userAgent String?   @db.VarChar(500)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  tokenHash String @unique @db.VarChar(64)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  otpHash        String    @db.VarChar(64)
  attempts       Int       @default(0)
  expiresAt      DateTime
  verifiedAt     DateTime?
  resetTokenHash String?   @unique @db.VarChar(64)
  resetExpiresAt DateTime?
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model EmailOutbox {
  id               String    @id @default(uuid()) @db.Uuid
  encryptedPayload String?
  expiresAt        DateTime
  sentAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([sentAt, expiresAt])
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  label     String   @db.VarChar(50)
  street    String   @db.VarChar(255)
  city      String   @db.VarChar(100)
  state     String   @db.VarChar(100)
  country   String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  landmark String? @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Material {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)

  recyclerMaterials RecyclerMaterial[]
  pickupItems PickupItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecyclerMaterial {
  recyclerId String @db.Uuid
  materialId String @db.Uuid

  createdAt DateTime @default(now())

  recycler User @relation(fields: [recyclerId], references: [id], onDelete: Cascade)

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@id([recyclerId, materialId])
  @@index([materialId])
}

model PickupRequest {
  id          String       @id @default(uuid()) @db.Uuid
  householdId String       @db.Uuid
  collectorId String?      @db.Uuid
  status      PickupStatus @default(PENDING)
  
  street   String  @db.VarChar(255)
  city     String  @db.VarChar(100)
  state    String  @db.VarChar(100)
  country  String  @db.VarChar(100)
  landmark String? @db.VarChar(255)

  notes String? @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  household User @relation("HouseholdPickups", fields: [householdId], references: [id], onDelete: Restrict)
  collector User? @relation("CollectorPickups", fields: [collectorId], references: [id], onDelete: Restrict)

  items PickupItem[]

  @@index([householdId, createdAt])
  @@index([collectorId, createdAt])
  @@index([status, createdAt])
}

model PickupItem {
  id              String   @id @default(uuid()) @db.Uuid
  pickupRequestId String   @db.Uuid
  materialId      String   @db.Uuid
  materialName    String   @db.VarChar(100)

  estimatedWeightKg Decimal? @db.Decimal(10, 3)

  pickupRequest PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)

  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([pickupRequestId, materialId])
  @@index([materialId])
}